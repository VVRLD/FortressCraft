# Whitelist: ignore everything, then include only FortCraft's source and docs.
*
!*/

!/.gitignore
!/.gitattributes
!/*.md
!/LICENSE
!/*.cmd
!/*.sh
!/third_party/**
!/prebuilt/*.bsp

!/protocol/*.h

!/tools/*.py
!/tools/*.bat
!/tools/*.ps1
!/tools/*.sh
!/tools/*.cpp

!/tf2mod/*.cpp
!/tf2mod/*.h
!/tf2mod/*.patch
!/tf2mod/*.md
!/tf2mod/maps/*.vmf
!/tf2mod/maps/buildgame/gameinfo.txt

!/fabric/.gitattributes
!/fabric/build.gradle
!/fabric/settings.gradle
!/fabric/gradle.properties
!/fabric/gradlew
!/fabric/gradlew.bat
!/fabric/gradle/wrapper/gradle-wrapper.jar
!/fabric/gradle/wrapper/gradle-wrapper.properties
!/fabric/src/**/*.java
!/fabric/src/**/*.json

# Never these: build output, downloads, logs, saves, local settings
/fabric/run/
/fabric/build/
/fabric/.gradle/
/logs/
/tools/config.local.cmd
