+//-----------------------------------------------------------------------------
+// FortCraft: when Minecraft sends a new recipe list (after crafting, or the inventory changed),
+// rebuild the buttons and keep the same recipe selected if it's still there.
+//-----------------------------------------------------------------------------
+void CCraftingPanel::OnThink( void )
+{
+	BaseClass::OnThink();
+
+	// A finished craft: TF2's metal pickup sound.
+	bool bOk = false;
+	const unsigned int nResults = FortCraft_CraftResults( &bOk );
+	if ( m_nFortCraftResultsSeen == 0xFFFFFFFF )
+		m_nFortCraftResultsSeen = nResults;
+	if ( nResults != m_nFortCraftResultsSeen )
+	{
+		m_nFortCraftResultsSeen = nResults;
+		if ( bOk && IsVisible() )
+			vgui::surface()->PlaySound( "ui/item_metal_scrap_pickup.wav" );
+	}
+
+	if ( !IsVisible() || FortCraft_RecipesVersion() == m_nFortCraftRecipesVersion )
+		return;
+	char szSelected[64] = "";
+	const int iOld = FortCraftRecipeIndex( m_iCurrentlySelectedRecipe );
+	if ( iOld >= 0 )
+		V_strncpy( szSelected, FortCraft_RecipeName( iOld ), sizeof( szSelected ) );
+	UpdateRecipeFilter();
+	if ( iOld < 0 )
+		return;
+	for ( int k = 0; k < FortCraft_RecipeCount(); k++ )
+	{
+		if ( !V_strcmp( FortCraft_RecipeName( k ), szSelected ) )
+		{
+			m_iCurrentlySelectedRecipe = FORTCRAFT_RECIPE_BASE - k;
+			UpdateSelectedRecipe( true );
+			UpdateCraftButton();
+			break;
+		}
+	}
+}
