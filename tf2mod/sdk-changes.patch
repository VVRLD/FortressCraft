 int CBaseEntity::BaseInterpolatePart1( float &currentTime, Vector &oldOrigin, QAngle &oldAngles, Vector &oldVel, int &bNoMoreChanges )
 {
+#ifdef TF_CLIENT_DLL
+	// Hermite smoothing can overshoot a stopped hull into Minecraft walls, then
+	// spring back (observed in tf2_sent.log). Linear interpolation stays between
+	// the actual movement samples while retaining between-tick smoothness.
+	if ( this == C_BasePlayer::GetLocalPlayer() )
+	{
+		const int oldType = m_iv_vecOrigin.GetType();
+		const int newType = FortCraft_IsLinked() ? oldType | INTERPOLATE_LINEAR_ONLY
+			: oldType & ~INTERPOLATE_LINEAR_ONLY;
+		if ( oldType != newType )
+		{
+			m_iv_vecOrigin.Setup( &m_vecOrigin, newType );
+			Msg( "FortCraft movement: local origin interpolation %s (wall overshoot guard)\n",
+				( newType & INTERPOLATE_LINEAR_ONLY ) ? "linear" : "default" );
+		}
+	}
+#endif
 	// Don't mess with the world!!!
 	bNoMoreChanges = 1;
 	
