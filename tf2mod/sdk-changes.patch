+void CTFGrenadePipebombProjectile::FortCraft_OnMinecraftBlockHit( IPhysicsObject *pPhysics, const Vector &normal, bool bMob )
+{
+	// A pipe that hits a Minecraft mob before touching the ground explodes at once, as it would
+	// on a TF2 player.
+	if ( bMob && !m_bTouched && !HasStickyEffects() )
+	{
+		Msg( "FortCraft: pipe hit a Minecraft mob directly: detonating\n" );
+		Detonate();
+		return;
+	}
+
+	if ( m_bWallShatter )
+	{
+		Fizzle();
+		Detonate();
+		return;
+	}
+
+	if ( HasStickyEffects() )
+	{
+		if ( !m_bTouched )
+		{
+			m_bTouched = true;
+			m_bUseImpactNormal = true;
+			m_vecImpactNormal = normal;
+			m_flTouchedTime = gpGlobals->curtime;
+			pPhysics->EnableMotion( false );
+		}
+		return;
+	}
+
+	if ( !m_bTouched )
+		SetDamage( GetDamageScaleOnWorldContact() * GetDamage() );
+	m_bTouched = true;
+	BaseClass::FortCraft_OnMinecraftBlockHit( pPhysics, normal, bMob );
+}
