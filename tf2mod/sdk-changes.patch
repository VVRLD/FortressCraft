+// Bounce off a Minecraft block like off TF2's world: the part of the velocity into the surface
+// bounces back (scaled by elasticity) and the part along it is kept, with a little friction, so
+// grenades roll along the ground instead of stopping dead. A slow bounce just rests on the surface.
+void CTFWeaponBaseGrenadeProj::FortCraft_OnMinecraftBlockHit( IPhysicsObject *pPhysics, const Vector &normal, bool bMob )
+{
+	Vector velocity;
+	AngularImpulse angularVelocity;
+	pPhysics->GetVelocity( &velocity, &angularVelocity );
+	const float flInto = DotProduct( velocity, normal );
+	if ( flInto >= 0.0f )
+		return;  // already moving away
+	Vector along = velocity - flInto * normal;
+	float flBounce = -flInto * GetElasticity();
+	if ( flBounce < 60.0f )
+		flBounce = 0.0f;  // resting contact: no endless tiny hops
+	velocity = along * 0.97f + normal * flBounce;
+	// Spin as if rolling along the surface (degrees per second about the rolling axis).
+	Vector axis = CrossProduct( normal, along );
+	angularVelocity = axis * 2.0f;
+	pPhysics->SetVelocity( &velocity, &angularVelocity );
+}
