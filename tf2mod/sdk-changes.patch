+//-----------------------------------------------------------------------------
+// FortCraft: aim at and shoot the nearest hostile Minecraft mob in range and in view. TF2 sees
+// the mob only as a box, so the bullets are fired for the look (tracer, muzzle flash, sound) and
+// the hit is sent to Minecraft as a shot, where the damage is applied. Level 3 sentries also fire
+// their rockets at it (a real TF2 rocket: its blast hurts mobs in Minecraft). Returns false if
+// there is no such mob.
+//-----------------------------------------------------------------------------
+bool CObjectSentrygun::FortCraft_AttackMob( void )
+{
+	Vector vecTarget;
+	if ( !FortCraft_NearestHostileMob( EyePosition(), m_flSentryRange, vecTarget ) )
+		return false;
+
+	Vector vecDirToEnemy = vecTarget - EyePosition();
+	QAngle angToTarget;
+	VectorAngles( vecDirToEnemy, angToTarget );
+	angToTarget.y = UTIL_AngleMod( angToTarget.y );
+	if ( angToTarget.x < -180 )
+		angToTarget.x += 360;
+	if ( angToTarget.x > 180 )
+		angToTarget.x -= 360;
+	angToTarget.x = clamp( angToTarget.x, -50.0f, 50.0f );
+	m_vecGoalAngles.y = angToTarget.y;
+	m_vecGoalAngles.x = angToTarget.x;
+	MoveTurret();
+
+	if ( ( m_vecGoalAngles - m_vecCurAngles ).Length() > 10 )
+		return true;
+
+	// Level 3: a rocket every 3 seconds, like at a TF2 enemy.
+	if ( m_iUpgradeLevel == 3 && m_iAmmoRockets > 0 && m_flNextRocketAttack < gpGlobals->curtime )
+	{
+		Vector vecRocketSrc;
+		QAngle angUnused;
+		GetAttachment( m_iAttachments[ SENTRYGUN_ATTACHMENT_ROCKET ], vecRocketSrc, angUnused );
+		QAngle angAim;
+		VectorAngles( vecTarget - vecRocketSrc, angAim );
+		EmitSentrySound( "Building_Sentrygun.FireRocket" );
+		CTFProjectile_SentryRocket *pRocket = CTFProjectile_SentryRocket::Create( vecRocketSrc, angAim, this, GetBuilder() );
+		if ( pRocket )
+		{
+			int iDamage = 100;
+			CALL_ATTRIB_HOOK_INT_ON_OTHER( GetOwner(), iDamage, mult_engy_sentry_damage );
+			pRocket->SetDamage( iDamage );
+		}
+		AddGesture( ACT_RANGE_ATTACK2 );
+		m_flNextRocketAttack = gpGlobals->curtime + 3;
+		m_iAmmoRockets--;
+		Msg( "FortCraft: sentry %d fired a rocket at a hostile Minecraft mob\n", entindex() );
+	}
+
+	if ( m_flNextAttack > gpGlobals->curtime )
+		return true;
+	m_flNextAttack = gpGlobals->curtime + ( m_iUpgradeLevel == 1 ? 0.2f : 0.1f );
+	if ( m_iAmmoShells <= 0 )
+		return true;
+
+	if ( !IsPlayingGesture( ACT_RANGE_ATTACK1 ) )
+	{
+		RemoveGesture( ACT_RANGE_ATTACK1_LOW );
+		AddGesture( ACT_RANGE_ATTACK1 );
+	}
+
+	int iAttachment = GetFireAttachment();
+	Vector vecSrc;
+	QAngle vecAng;
+	GetAttachment( iAttachment, vecSrc, vecAng );
+	Vector vecAimDir = vecTarget - vecSrc;
+	const float flDist = vecAimDir.NormalizeInPlace();
+
+	FireBulletsInfo_t info;
+	info.m_vecSrc = vecSrc;
+	info.m_vecDirShooting = vecAimDir;
+	info.m_iTracerFreq = 1;
+	info.m_iShots = 1;
+	info.m_pAttacker = GetBuilder() ? (CBaseEntity *)GetBuilder() : (CBaseEntity *)this;
+	info.m_vecSpread = vec3_origin;
+	info.m_flDistance = flDist + 100;
+	info.m_iAmmoType = m_iAmmoType;
+	info.m_flDamage = IsMiniBuilding() ? tf_sentrygun_mini_damage.GetFloat() : tf_sentrygun_damage.GetFloat();
+	CALL_ATTRIB_HOOK_FLOAT_ON_OTHER( GetOwner(), info.m_flDamage, mult_engy_sentry_damage );
+	FireBullets( info );
+	// At least 4 blocks: shorter shots count as melee swings in Minecraft's shot reader.
+	FortCraft_ReportShot( vecSrc, vecAimDir, MAX( flDist + 100.0f, 200.0f ), info.m_flDamage );
+
+	CEffectData data;
+	data.m_nEntIndex = entindex();
+	data.m_nAttachmentIndex = iAttachment;
+	data.m_fFlags = m_iUpgradeLevel;
+	data.m_vOrigin = vecSrc;
+	DispatchEffect( "TF_3rdPersonMuzzleFlash_SentryGun", data );
+	EmitSentrySound( m_iUpgradeLevel == 3 ? "Building_Sentrygun.Fire3" : m_iUpgradeLevel == 2 ? "Building_Sentrygun.Fire2" : "Building_Sentrygun.Fire" );
+	m_iAmmoShells--;
+
+	static int s_nLogged = 0;
+	if ( s_nLogged++ < 10 )
+		Msg( "FortCraft: sentry %d shot a hostile Minecraft mob at %.0f units (damage %.0f)\n", entindex(), flDist, info.m_flDamage );
+	return true;
+}
