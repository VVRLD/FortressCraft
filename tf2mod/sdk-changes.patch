diff --git a/src/game/client/c_baseanimating.cpp b/src/game/client/c_baseanimating.cpp
index d365dc1..c5b2bf7 100644
--- a/src/game/client/c_baseanimating.cpp
+++ b/src/game/client/c_baseanimating.cpp
@@ -3385,9 +3385,47 @@ private:
 // Purpose: Draws the object
 // Input  : flags - 
 //-----------------------------------------------------------------------------
+#ifdef TF_CLIENT_DLL
+bool FortCraft_IsLinked();     // fortcraft_link.cpp
+float FortCraft_WorldLight();
+
+// FortCraft: TF2's map light doesn't reach Minecraft's world, so while linked every model is lit
+// by an even ambient light as bright as Minecraft's world at the player (bright by day, dark at
+// night), with no local lights: the whole model dims evenly, including its shine.
+class CFortCraftModelLighting
+{
+public:
+	CFortCraftModelLighting()
+	{
+		m_bActive = FortCraft_IsLinked() && g_pStudioRender && modelrender;
+		if ( !m_bActive )
+			return;
+		const float l = FortCraft_WorldLight();
+		Vector cube[ 6 ];  // +x -x +y -y +z(top) -z(bottom)
+		for ( int i = 0; i < 4; ++i )
+			cube[ i ].Init( 0.85f * l, 0.85f * l, 0.85f * l );
+		cube[ 4 ].Init( l, l, l );
+		cube[ 5 ].Init( 0.6f * l, 0.6f * l, 0.6f * l );
+		modelrender->SuppressEngineLighting( true );
+		g_pStudioRender->SetAmbientLightColors( cube );
+		g_pStudioRender->SetLocalLights( 0, NULL );
+	}
+	~CFortCraftModelLighting()
+	{
+		if ( m_bActive )
+			modelrender->SuppressEngineLighting( false );
+	}
+private:
+	bool m_bActive;
+};
+#endif
+
 int C_BaseAnimating::InternalDrawModel( int flags )
 {
 	VPROF( "C_BaseAnimating::InternalDrawModel" );
+#ifdef TF_CLIENT_DLL
+	CFortCraftModelLighting fortcraftLighting;
+#endif
 
 #ifdef TF_CLIENT_DLL
 	MaterialOverrideRestore overrideRestore;
