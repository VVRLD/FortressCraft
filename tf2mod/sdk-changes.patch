+			CSoundParameters params;
+			if ( hitSound.m_pszName && CBaseEntity::GetParametersForSound( hitSound.m_pszName, params, NULL ) )
+			{
+				CLocalPlayerFilter filter;
+				EmitSound_t es( params );
+				es.m_nPitch = hitSound.GetPitchFromDamage( iDamage, bLastHit );
+				es.m_flVolume = bLastHit ? tf_dingaling_lasthit_volume.GetFloat() : tf_dingaling_volume.GetFloat();
+				pLocalPlayer->EmitSound( filter, pLocalPlayer->entindex(), es );
+			}
+		}
+
+		if ( hud_combattext.GetBool() )
+		{
+			account_delta_t *pNewAccount = OnAccountValueChanged( 0, -iDamage, account_delta_t::ACCOUNT_DELTA_DAMAGE );
+			if ( pNewAccount )
